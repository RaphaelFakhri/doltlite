# When the largest positive rowid is already present, the next implicit
# insert picks a free id. AUTOINCREMENT still fails. The counter does not
# restart after a delete.
set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_rowid_full

do_execsql_test 1.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY);
  INSERT INTO t(id) VALUES(9223372036854775807);
  INSERT INTO t DEFAULT VALUES;
  INSERT INTO t DEFAULT VALUES;
  SELECT count(*), max(id),
         count(*) FILTER (WHERE id>0 AND id<9223372036854775807)
    FROM t;
} {3 9223372036854775807 2}

do_execsql_test 2.0 {
  CREATE TABLE a(id INTEGER PRIMARY KEY AUTOINCREMENT);
  INSERT INTO a(id) VALUES(9223372036854775807);
} {}
do_catchsql_test 2.1 {
  INSERT INTO a DEFAULT VALUES;
} {1 {database or disk is full}}

do_execsql_test 3.0 {
  CREATE TABLE c(id INTEGER PRIMARY KEY);
  INSERT INTO c DEFAULT VALUES;
  DELETE FROM c;
  INSERT INTO c DEFAULT VALUES;
  SELECT id FROM c;
} {2}

finish_test
