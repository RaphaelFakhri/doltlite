set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix doltlite_chunker_canonical_root

reset_db
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  SELECT dolt_commit('-Am', 'empty table');
  SELECT dolt_checkout('-b', 'forward');
  INSERT INTO t VALUES(1, printf('%.*c', 4000, 'p')),
                      (2, printf('%.*c', 4000, 'q'));
  SELECT dolt_commit('-Am', 'forward rows');
  SELECT dolt_checkout('main');
  SELECT dolt_checkout('-b', 'reverse');
  INSERT INTO t VALUES(2, printf('%.*c', 4000, 'q'));
  INSERT INTO t VALUES(1, printf('%.*c', 4000, 'p'));
  SELECT dolt_commit('-Am', 'reverse rows');
}

do_execsql_test 1.1 {
  SELECT count(*) FROM dolt_diff_t('forward', 'reverse');
} {0}
do_execsql_test 1.2 {
  SELECT dolt_hashof_table('t', 'forward') =
         dolt_hashof_table('t', 'reverse');
} {1}
do_execsql_test 1.3 {
  SELECT count(*) FROM dolt_diff_summary('forward', 'reverse');
} {0}
do_execsql_test 1.4 {
  SELECT count(*) FROM dolt_diff_stat('forward', 'reverse');
} {0}

execsql {
  SELECT dolt_checkout('forward');
  DELETE FROM t;
  INSERT INTO t VALUES(2, printf('%.*c', 4000, 'q'));
  INSERT INTO t VALUES(1, printf('%.*c', 4000, 'p'));
}
set head [db one {SELECT dolt_hashof('HEAD')}]
do_execsql_test 2.1 { SELECT count(*) FROM dolt_status; } {0}
do_execsql_test 2.2 {
  SELECT dolt_hashof_table('t', 'WORKING') = dolt_hashof_table('t', 'HEAD');
} {1}
do_catchsql_test 2.3 {
  SELECT dolt_commit('-am', 'identical rows');
} {1 {nothing to commit, working tree clean (use dolt_add to stage changes)}}
do_test 2.4 {
  expr {[db one {SELECT dolt_hashof('HEAD')}] eq $head}
} {1}

db close
sqlite3 db test.db
execsql { SELECT dolt_checkout('forward'); }
do_execsql_test 3.1 { SELECT count(*) FROM dolt_status; } {0}
do_execsql_test 3.2 {
  SELECT dolt_hashof_table('t', 'forward') =
         dolt_hashof_table('t', 'reverse');
} {1}
do_execsql_test 3.3 { SELECT id, length(v) FROM t ORDER BY id; } {1 4000 2 4000}
do_execsql_test 3.4 { PRAGMA integrity_check; } {ok}

reset_db
execsql {
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  WITH RECURSIVE s(i) AS (
    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<338
  ) INSERT INTO t SELECT i, printf('%.*c', 1000, 'x') FROM s;
  SELECT dolt_commit('-Am', 'bulk rows');
  SELECT dolt_branch('bulk');
  DELETE FROM t;
  WITH RECURSIVE s(i) AS (
    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<337
  ) INSERT INTO t SELECT i, printf('%.*c', 1000, 'x') FROM s;
  INSERT INTO t VALUES(338, printf('%.*c', 1000, 'x'));
}

do_execsql_test 4.1 {
  SELECT dolt_hashof_table('t') = dolt_hashof_table('t', 'HEAD');
} {1}
do_execsql_test 4.2 {
  SELECT count(*) FROM dolt_diff_t('HEAD', 'WORKING');
} {0}
do_execsql_test 4.3 { SELECT count(*) FROM dolt_status; } {0}
set head [db one {SELECT dolt_hashof('HEAD')}]
do_catchsql_test 4.4 {
  SELECT dolt_commit('-am', 'identical appended rows');
} {1 {nothing to commit, working tree clean (use dolt_add to stage changes)}}
do_test 4.5 {
  expr {[db one {SELECT dolt_hashof('HEAD')}] eq $head}
} {1}

db close
sqlite3 db test.db
foreach stage {reopen gc} {
  if {$stage eq "gc"} { execsql { SELECT dolt_gc(); } }
  do_execsql_test 5.$stage.hash {
    SELECT dolt_hashof_table('t') = dolt_hashof_table('t', 'bulk');
  } {1}
  do_execsql_test 5.$stage.rows {
    SELECT count(*), sum(id), sum(length(v)),
           count(*) FILTER (WHERE v != printf('%.*c', 1000, 'x')) FROM t;
  } {338 57291 338000 0}
  do_execsql_test 5.$stage.integrity { PRAGMA integrity_check; } {ok}
}

finish_test
