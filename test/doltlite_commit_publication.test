set testdir [file dirname $argv0]
source $testdir/tester.tcl

proc publication_snapshot {handle} {
  $handle eval {
    SELECT count(*) FROM dolt_log;
    SELECT count(*) FROM t;
  }
}

proc publication_decline {n} {
  incr ::busyCalls
  return 1
}

proc publication_sync {method file args} {
  if {$::armed && [string match *test.db $file]} {
    set ::armed 0
    set ::during [publication_snapshot peer]
    set ::openError [catch {sqlite3 observer test.db} ::openMessage]
    if {!$::openError} {
      observer busy publication_decline
      set ::readError [catch {publication_snapshot observer} ::freshDuring]
    }
    if {$::fail} {return SQLITE_IOERR}
  }
  return SQLITE_OK
}

testvfs tvfs
tvfs filter xSync
tvfs script publication_sync
set ::armed 0
foreach branch {main dev} {
  foreach kind {sql vc} {
    foreach ::fail {0 1} {
      catch {db close}
      forcedelete test.db
      sqlite3 db test.db -vfs tvfs
      db eval {
        CREATE TABLE t(k INTEGER PRIMARY KEY,v);
        INSERT INTO t VALUES(1,'a');
        SELECT dolt_commit('-Am','c1');
      }
      if {$branch eq "dev"} {
        db eval {
          SELECT dolt_branch('dev');
          SELECT dolt_checkout('dev');
          SELECT dolt_default_branch('dev');
        }
      }
      db eval {
        INSERT INTO t VALUES(2,'working');
      }
      sqlite3 peer test.db
      set before [publication_snapshot peer]
      set ::during {}
      set ::freshDuring {}
      set ::openError 0
      set ::readError 0
      set ::busyCalls 0
      set ::armed 1
      if {$kind eq "vc"} {
        set failed [catch {db eval {SELECT dolt_commit('-Am','c2')}}]
      } else {
        set failed [catch {db eval {INSERT INTO t VALUES(3,randomblob(50000))}}]
      }
      set ::armed 0
      set prefix commit-publication-$branch-$kind-$::fail
      do_test $prefix.result {set failed} $::fail
      do_test $prefix.during-live {set ::during} $before
      do_test $prefix.during-open {set ::openError} 0
      do_test $prefix.during-fresh {
        expr {($::readError && [string match *locked* $::freshDuring])
            || (!$::readError && $::freshDuring eq $before)}
      } 1
      do_test $prefix.during-busy-handler {set ::busyCalls} 1
      set expected $before
      if {!$::fail} {
        set index [expr {$kind eq "vc" ? 0 : 1}]
        lset expected $index [expr {[lindex $expected $index]+1}]
      }
      do_test $prefix.after-live {publication_snapshot peer} $expected
      do_test $prefix.after-observer {publication_snapshot observer} $expected
      do_test $prefix.observer-branch {observer one {SELECT active_branch()}} $branch
      observer close
      do_test $prefix.peer-write {
        peer eval {INSERT INTO t VALUES(4,'peer'); SELECT group_concat(k) FROM t}
      } [expr {$kind eq "sql" && !$::fail ? "1,2,3,4" : "1,2,4"}]
      peer close
      db close
      sqlite3 db test.db
      do_test $prefix.reopen {
        list [db one {SELECT count(*) FROM dolt_log}] \
             [db one {SELECT count(*) FROM t}] [db one {PRAGMA integrity_check}]
      } [list [lindex $expected 0] [expr {[lindex $expected 1]+1}] ok]
    }
  }
}

db close
tvfs delete

testvfs busyvfs
busyvfs filter xLock
proc publication_busy_lock {method file level} {
  if {$::publicationBusy && [string match *test.db $file] && $level==4} {
    return SQLITE_BUSY
  }
  return SQLITE_OK
}
busyvfs script publication_busy_lock
set publicationBusy 0
set hadDrainLimit [info exists env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)]
if {$hadDrainLimit} {set savedDrainLimit $env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)}
foreach action {commit release rollback savepoint schema spill} {
  forcedelete test.db
  sqlite3 db test.db -vfs busyvfs
  execsql {
    CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT, payload BLOB);
    CREATE INDEX tv ON t(v);
    INSERT INTO t(id,v) VALUES(1,'base');
    SELECT dolt_commit('-Am','base');
  }
  if {$action eq "release"} {
    execsql {SAVEPOINT outer}
    set finish {RELEASE outer}
  } else {
    execsql {BEGIN}
    set finish {COMMIT}
  }
  if {$action eq "spill"} {set env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT) 32768}
  execsql {INSERT INTO t(v) VALUES('pending')}
  if {$action eq "spill"} {
    execsql {UPDATE t SET payload=randomblob(1000000) WHERE id=2}
  }
  if {$action eq "savepoint"} {
    execsql {SAVEPOINT inner; INSERT INTO t(v) VALUES('discarded')}
  }
  if {$action eq "schema"} {
    execsql {
      CREATE TABLE extra(id INTEGER PRIMARY KEY, v TEXT);
      CREATE INDEX ev ON extra(v);
      INSERT INTO extra VALUES(9,'pending');
    }
  }
  set publicationBusy 1
  set prefix publication-busy-$action
  do_test $prefix.refused {
    set rc [catch {execsql $finish} msg]
    list $rc [db errorcode]
  } {1 5}
  do_test $prefix.transaction-open {sqlite3_get_autocommit db} 0
  set expected {1 base 2 pending}
  if {$action eq "savepoint"} {lappend expected 3 discarded}
  do_execsql_test $prefix.rows {
    SELECT id,v FROM t INDEXED BY tv ORDER BY id;
  } $expected
  do_test $prefix.refused-again {
    set rc [catch {execsql $finish} msg]
    list $rc [db errorcode]
  } {1 5}
  do_execsql_test $prefix.still-kept {SELECT id,v FROM t ORDER BY id} $expected
  if {$action eq "spill"} {
    do_execsql_test $prefix.spill-kept {
      SELECT length(payload) FROM t WHERE id=2;
    } 1000000
  }
  if {$action eq "rollback"} {
    do_execsql_test $prefix.rollback {ROLLBACK; SELECT id,v FROM t} {1 base}
  } else {
    if {$action eq "savepoint"} {
      do_execsql_test $prefix.rollback-to {
        ROLLBACK TO inner;
        SELECT id,v FROM t ORDER BY id;
      } {1 base 2 pending}
      execsql {RELEASE inner}
    }
    if {$action eq "schema"} {
      do_execsql_test $prefix.schema-kept {
        SELECT id,v FROM extra INDEXED BY ev;
      } {9 pending}
    }
    do_execsql_test $prefix.next-write {
      INSERT INTO t(v) VALUES('later');
      SELECT id,v FROM t ORDER BY id;
    } {1 base 2 pending 3 later}
    set expected {1 base 2 pending 3 later}
    set publicationBusy 0
    do_execsql_test $prefix.retry $finish {}
  }
  set publicationBusy 0
  do_test $prefix.transaction-ended {sqlite3_get_autocommit db} 1
  db close
  sqlite3 db test.db
  if {$action eq "rollback"} {set expected {1 base}}
  do_execsql_test $prefix.reopen {
    SELECT id,v FROM t INDEXED BY tv ORDER BY id;
  } $expected
  do_execsql_test $prefix.integrity {PRAGMA integrity_check} ok
  if {$action eq "schema"} {
    do_execsql_test $prefix.schema-reopen {
      SELECT id,v FROM extra INDEXED BY ev;
    } {9 pending}
  }
  if {$action eq "spill"} {
    do_execsql_test $prefix.spill-reopen {
      SELECT length(payload) FROM t WHERE id=2;
    } 1000000
  }
  db close
}
if {$hadDrainLimit} {
  set env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT) $savedDrainLimit
} else {
  unset env(DOLTLITE_CHUNK_PENDING_DRAIN_LIMIT)
}
busyvfs delete
sqlite3 db test.db
finish_test
