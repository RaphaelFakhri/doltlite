set testdir [file dirname $argv0]
source $testdir/tester.tcl

foreach {layout key} {integer {INTEGER PRIMARY KEY} clustered {INT PRIMARY KEY}} {
  foreach operation {merge cherry_pick} {
    foreach boundary {transaction savepoint} {
      reset_db
      execsql "CREATE TABLE w(id $key,v TEXT)"
      execsql {
        INSERT INTO w VALUES(1,'base');
        SELECT dolt_commit('-Am','base');
        SELECT dolt_checkout('-b','other');
        CREATE INDEX iw ON w(v);
        UPDATE w SET v='other';
        INSERT INTO w VALUES(2,'other');
        SELECT dolt_commit('-am','other');
        SELECT dolt_checkout('main');
        UPDATE w SET v='main';
        SELECT dolt_commit('-am','main');
      }
      set prefix conflict-baseline-$layout-$operation-$boundary
      set before [execsql {
        SELECT type,name,tbl_name,rootpage,sql FROM sqlite_schema ORDER BY name;
      }]
      do_test $prefix-conflict {
        set result [catchsql "SELECT dolt_${operation}('other')"]
        list [lindex $result 0] [string match {*conflicts detected*} [lindex $result 1]]
      } {1 1}
      do_execsql_test $prefix-restored {SELECT * FROM w} {1 main}
      if {$boundary eq "transaction"} {
        execsql {BEGIN IMMEDIATE; ROLLBACK}
      } else {
        execsql {SAVEPOINT s; INSERT INTO w VALUES(99,'temporary'); ROLLBACK TO s; RELEASE s}
      }
      do_execsql_test $prefix-rollback-rows {SELECT * FROM w ORDER BY id} {1 main}
      do_test $prefix-rollback-schema {
        execsql {SELECT type,name,tbl_name,rootpage,sql FROM sqlite_schema ORDER BY name}
      } $before
      do_execsql_test $prefix-later-write {
        INSERT INTO w VALUES(3,'new');
        CREATE TABLE d(x);
        SELECT * FROM w ORDER BY id;
        PRAGMA integrity_check;
      } {1 main 3 new ok}
      do_execsql_test $prefix-no-conflicts {SELECT count(*) FROM dolt_conflicts} {0}
      execsql {SELECT dolt_commit('-Am','after failure')}
      db close
      sqlite3 db test.db
      do_execsql_test $prefix-reopen {
        SELECT * FROM w ORDER BY id;
        SELECT count(*) FROM sqlite_schema WHERE name='iw';
        PRAGMA integrity_check;
      } {1 main 3 new 0 ok}
    }
  }
}

finish_test
