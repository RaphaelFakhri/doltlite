set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl
set testprefix doltlite-correlated-in

proc correlated_in_plan {conn sql} {
  set plan {}
  $conn eval "EXPLAIN QUERY PLAN $sql" row {lappend plan $row(detail)}
  return $plan
}

foreach {key decl keyexpr} {
  integer {INTEGER PRIMARY KEY} i
  text {TEXT PRIMARY KEY} {printf('%016x',i)}
  blob {BLOB PRIMARY KEY} {CAST(printf('%016x',i) AS BLOB)}
  composite {TEXT,PRIMARY KEY(id,seq)} {printf('%016x',i)}
} {
  foreach {layout group} {
    early {(i-1)/128}
    late {15-(i-1)/128}
    scattered {i%16}
  } {
    reset_db
    forcedelete correlated-in-oracle.db
    sqlite3 oracle {file:correlated-in-oracle.db?doltlite_engine=sqlite} -uri 1
    if {$key eq "composite"} {
      set schema {id TEXT,seq INTEGER,grp INTEGER,PRIMARY KEY(id,seq)}
    } else {
      set schema "id $decl,seq INTEGER,grp INTEGER"
    }
    foreach conn {db oracle} {
      $conn eval "
        CREATE TABLE t($schema);
        WITH RECURSIVE c(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM c WHERE i<2048)
        INSERT INTO t SELECT $keyexpr,i,$group FROM c;
        CREATE INDEX t_g ON t(grp);
        CREATE INDEX t_s ON t(seq);
        CREATE TABLE u(id INTEGER PRIMARY KEY,grp INTEGER);
        INSERT INTO u SELECT seq,grp FROM t WHERE seq%8=0;
        CREATE INDEX u_g ON u(grp);
        ANALYZE;
      "
    }
    set query {
      SELECT count(*),sum(seq) FROM (
        SELECT seq FROM t WHERE grp<4
          AND seq IN (SELECT id FROM u WHERE grp=t.grp)
        ORDER BY seq LIMIT 8
      )
    }
    do_test $key-$layout-plan {
      expr {[lsearch -glob [correlated_in_plan db $query] {*u EXISTS*}]>=0}
    } {1}
    do_test $key-$layout-stock-plan {
      expr {[lsearch -glob [correlated_in_plan oracle $query] {*CORRELATED LIST*}]>=0}
    } {1}
    do_test $key-$layout-result {db eval $query} [oracle eval $query]
    if {$layout eq "early"} {
      do_vmstep_test $key-early-work $query 5000 {8 288}
    }
    foreach {variant sql} [list \
        offset [string map {{LIMIT 8} {LIMIT 8 OFFSET 40}} $query] \
        desc [string map {{ORDER BY seq} {ORDER BY seq DESC}} $query] \
        pending {BEGIN; UPDATE u SET grp=grp+1 WHERE id%16=0} \
        after-pending $query \
        delete {DELETE FROM u WHERE id%24=0} \
        after-delete $query \
        rollback {ROLLBACK} \
        after-rollback $query] {
      do_test $key-$layout-$variant {db eval $sql} [oracle eval $sql]
    }
    oracle close
  }
}

reset_db
forcedelete correlated-in-oracle.db
sqlite3 oracle {file:correlated-in-oracle.db?doltlite_engine=sqlite} -uri 1
foreach conn {db oracle} {
  $conn eval {
    CREATE TABLE t(id INTEGER PRIMARY KEY,seq INTEGER,grp TEXT COLLATE NOCASE);
    CREATE TABLE u(id INTEGER PRIMARY KEY,grp TEXT COLLATE BINARY);
    INSERT INTO t VALUES(1,NULL,'a'),(2,1,'A'),(3,1.5,'a'),(4,x'31','a'),
      (5,'nonnumeric','a'),(6,-1,'a'),(7,9007199254740993,'a'),
      (8,9223372036854775807,'a'),(9,'9223372036854775808','a'),(10,1,NULL);
    INSERT INTO u VALUES(1,'a'),(-1,'a'),(9007199254740993,'a'),
      (9223372036854775807,'a');
    CREATE TABLE nullable(id INTEGER,grp TEXT);
    INSERT INTO nullable VALUES(1,'a'),(NULL,'a'),(1,'a');
    CREATE VIEW uv AS SELECT id,grp FROM u;
    CREATE TABLE w(id INTEGER PRIMARY KEY);
    INSERT INTO w VALUES(1),(2),(4);
  }
}
foreach {name sql} {
  affinity {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY id}
  reverse-collation {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE t.grp=grp) ORDER BY id}
  projected {SELECT id,seq IN (SELECT id FROM u WHERE grp=t.grp) FROM t ORDER BY id}
  not-in {SELECT id FROM t WHERE seq NOT IN (SELECT id FROM nullable WHERE grp=t.grp) ORDER BY id}
  nullable {SELECT id FROM t WHERE seq IN (SELECT id FROM nullable WHERE grp=t.grp) ORDER BY id}
  disjunction {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp) OR seq IS NULL ORDER BY id}
  limit {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp LIMIT 1) ORDER BY id}
  ordered {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp ORDER BY id) ORDER BY id}
  aggregate {SELECT id FROM t WHERE seq IN (SELECT max(id) FROM u WHERE grp=t.grp) ORDER BY id}
  distinct {SELECT id FROM t WHERE seq IN (SELECT DISTINCT id FROM u WHERE grp=t.grp) ORDER BY id}
  compound {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp UNION SELECT 1) ORDER BY id}
  expression {SELECT id FROM t WHERE seq IN (SELECT id+0 FROM u WHERE grp=t.grp) ORDER BY id}
  view {SELECT id FROM t WHERE seq IN (SELECT id FROM uv WHERE grp=t.grp) ORDER BY id}
  function {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE lower(grp)=t.grp) ORDER BY id}
  text-affinity {SELECT id FROM t WHERE CAST(seq AS TEXT) IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY id}
  vector {SELECT id FROM t WHERE (seq,grp) IN (SELECT id,grp FROM u WHERE grp=t.grp) ORDER BY id}
  nested {SELECT id FROM t WHERE EXISTS(SELECT 1 FROM u AS a WHERE a.id IN (SELECT id FROM u WHERE grp=t.grp)) ORDER BY id}
  left-join {SELECT t.id,w.id FROM t LEFT JOIN w ON w.id=t.id WHERE t.seq IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY t.id}
  right-join {SELECT t.id,w.id FROM w RIGHT JOIN t ON w.id=t.id WHERE t.seq IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY t.id}
  full-join {SELECT t.id,w.id FROM w FULL JOIN t ON w.id=t.id WHERE t.seq IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY t.id}
} {
  do_test edge-$name {db eval $sql} [oracle eval $sql]
}
do_test edge-affinity-plan {
  expr {[lsearch -glob [correlated_in_plan db {
    SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp)
  }] {*u EXISTS*}]>=0}
} {1}
oracle close
forcedelete correlated-in-oracle.db
reset_db
db eval {
  CREATE TABLE t(id INTEGER PRIMARY KEY,seq INTEGER,grp INTEGER);
  CREATE TABLE u(id INTEGER PRIMARY KEY,grp INTEGER);
  INSERT INTO t VALUES(1,1,1),(2,2,1),(3,NULL,1);
  INSERT INTO u VALUES(1,1),(2,1);
}
faultsim_save_and_close
do_faultsim_test allocation -faults oom-transient -prep {
  faultsim_restore_and_reopen
} -body {
  db eval {SELECT id FROM t WHERE seq IN (SELECT id FROM u WHERE grp=t.grp) ORDER BY id}
} -test {
  faultsim_test_result {0 {1 2}} {1 {out of memory}}
}
finish_test
