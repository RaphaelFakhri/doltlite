set testdir [file dirname $argv0]
source $testdir/tester.tcl

# A bound value past SQLITE_LIMIT_LENGTH fails the statement and is not
# written. A value of exactly that limit is a legal bind. Inserts use a
# shorter string because the stored record is larger than the value.

set limit 1000
sqlite3_limit db SQLITE_LIMIT_LENGTH $limit
set big [string repeat a [expr {$limit+1}]]
set exact [string repeat b $limit]
set ok [string repeat c 100]

do_execsql_test doltlite_bind_length-1.0 {
  CREATE TABLE t(x);
} {}

do_catchsql_test doltlite_bind_length-1.1 {
  INSERT INTO t VALUES($big);
} {1 {string or blob too big}}

do_execsql_test doltlite_bind_length-1.2 {
  SELECT count(*) FROM t;
} {0}

do_execsql_test doltlite_bind_length-1.3 {
  SELECT length($exact);
} [list $limit]

do_catchsql_test doltlite_bind_length-1.4 {
  INSERT INTO t VALUES($ok);
} {0 {}}

do_execsql_test doltlite_bind_length-1.5 {
  SELECT length(x) FROM t;
} {100}

ifcapable fts5 {
  do_catchsql_test doltlite_bind_length-2.0 {
    CREATE VIRTUAL TABLE f USING fts5(x);
  } {0 {}}
  do_catchsql_test doltlite_bind_length-2.1 {
    INSERT INTO f VALUES($big);
  } {1 {string or blob too big}}
  do_execsql_test doltlite_bind_length-2.2 {
    SELECT count(*) FROM f;
  } {0}
  do_catchsql_test doltlite_bind_length-2.3 {
    INSERT INTO f VALUES($ok);
  } {0 {}}
  do_execsql_test doltlite_bind_length-2.4 {
    SELECT length(x) FROM f;
  } {100}
}

do_test doltlite_bind_length-3.1 {
  set stmt [sqlite3_prepare_v2 db {INSERT INTO t(x) VALUES(?)} -1 TAIL]
  set rc1 [catch {sqlite3_bind_text $stmt 1 $big [string length $big]} msg]
  set step [sqlite3_step $stmt]
  set reset [sqlite3_reset $stmt]
  sqlite3_bind_text $stmt 1 $ok [string length $ok]
  set step2 [sqlite3_step $stmt]
  sqlite3_finalize $stmt
  list $rc1 $msg $step $reset $step2
} {1 SQLITE_TOOBIG SQLITE_TOOBIG SQLITE_TOOBIG SQLITE_DONE}

do_execsql_test doltlite_bind_length-3.2 {
  SELECT count(*), max(length(x)) FROM t;
} {2 100}

do_test doltlite_bind_length-3.3 {
  set stmt [sqlite3_prepare_v2 db {INSERT INTO t(x) VALUES(?)} -1 TAIL]
  catch {sqlite3_bind_text $stmt 1 $big [string length $big]}
  sqlite3_bind_null $stmt 1
  set step [sqlite3_step $stmt]
  sqlite3_finalize $stmt
  set step
} {SQLITE_DONE}

do_test doltlite_bind_length-3.4 {
  set stmt [sqlite3_prepare_v2 db {INSERT INTO t(x) VALUES(?)} -1 TAIL]
  set rc1 [catch {sqlite3_bind_blob $stmt 1 $big [string length $big]} msg]
  set err [sqlite3_errcode db]
  set step [sqlite3_step $stmt]
  sqlite3_reset $stmt
  sqlite3_clear_bindings $stmt
  set step2 [sqlite3_step $stmt]
  sqlite3_finalize $stmt
  list $rc1 $err $step $step2
} {1 SQLITE_TOOBIG SQLITE_TOOBIG SQLITE_DONE}

do_execsql_test doltlite_bind_length-3.5 {
  SELECT count(*) FROM t WHERE x IS NULL;
} {2}

do_test doltlite_bind_length-3.6 {
  set stmt [sqlite3_prepare_v2 db {SELECT length(?)} -1 TAIL]
  catch {sqlite3_bind_text $stmt 1 $big [string length $big]}
  sqlite3_reset $stmt
  sqlite3_bind_text $stmt 1 $exact [string length $exact]
  set step [sqlite3_step $stmt]
  set n [sqlite3_column_text $stmt 0]
  sqlite3_finalize $stmt
  list $step $n
} [list SQLITE_ROW $limit]

finish_test
